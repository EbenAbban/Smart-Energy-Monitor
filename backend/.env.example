# Neon Postgres (https://console.neon.tech -> your project -> Connect)
# DATABASE_URL: pooled connection (via PgBouncer) - used by the running app
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
# DIRECT_URL: unpooled connection - used by `prisma migrate` / `prisma db push`
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

PORT=4000
